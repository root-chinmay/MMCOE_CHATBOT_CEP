# MMCOE AI Chatbot Configuration
# Copy this file to .env for local testing or set these variables in Vercel Project Settings

# MongoDB Atlas connection string (Free cluster on mongodb.com)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mmcoe_chatbot?retryWrites=true&w=majority
MONGODB_URI=

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
# Used to answer any questions not related to MMCOE (general knowledge, coding, math, career, etc.)
GEMINI_API_KEY=

# Admin Credentials
ADMIN_EMAIL=admin@mmcoe.edu.in
ADMIN_PASSWORD=mmcoe@admin2024

# Local Server Port (optional, defaults to 3000)
PORT=3000

